# Copy to .env and fill in. Load in a shell with: set -a; source .env; set +a
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Where heavy local state lives (external SSD on the dev machine)
DATA_ROOT=/Volumes/ColimaData/mlops-a3
UV_CACHE_DIR=${DATA_ROOT}/uv-cache
AIRFLOW_HOME=${DATA_ROOT}/airflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
AIRFLOW_API_URL=http://127.0.0.1:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=
K8S_NAMESPACE=mlops-app
